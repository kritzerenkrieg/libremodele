{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "libremodele",
  "version": "0.1.0",
  "identifier": "app.libremodele",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      { "title": "libremodele", "width": 1200, "height": 800, "minWidth": 900, "minHeight": 600, "dragDropEnabled": true }
    ],
    "security": { "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'" }
  },
  "bundle": { "active": false, "icon": ["icons/icon.png"] }
}
